# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it contains secret keys.

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — always needed (used for embeddings, and for answers by default)
OPENAI_API_KEY=sk-...

# Which model writes the answers: "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# EMBEDDING_MODEL=text-embedding-3-small
